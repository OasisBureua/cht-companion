# Catalog check: finds new clips and writes one SQS message each.
#   docker build -f Dockerfile.enqueue -t kb-enqueue .

FROM public.ecr.aws/lambda/python:3.11

COPY requirements-common.txt requirements-enqueue.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r requirements-common.txt -r requirements-enqueue.txt --target ${LAMBDA_TASK_ROOT}

COPY enqueue_handler.py discovery.py enqueue.py store.py ${LAMBDA_TASK_ROOT}/

CMD ["enqueue_handler.handler"]
