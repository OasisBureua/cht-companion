# Local dev / tests: set DATABASE_URL directly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cht_companion

# Lambda (dev/prod): DATABASE_URL is not injected directly — only
# DATABASE_SECRET_ARN is set (see the ecs-companion vs kb/lambda Terraform
# modules; ECS resolves the secret's `url` key at task launch, Lambda has no
# equivalent so store.py fetches it via boto3 at cold start). Leave
# DATABASE_URL unset in that environment; DATABASE_SECRET_ARN takes over.
# DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:...:secret:cht-dev-companion-database-secrets-XXXXXX

AWS_REGION=us-east-1
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Set on the KB Lambda by Terraform. Required for the scheduled discovery
# run to enqueue ingest messages. Leave unset for local tests.
# KB_INGEST_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/cht-dev-companion-kb-ingest

# Drop-zone bucket. Uploads of .pdf .docx .txt .md invoke this Lambda.
# Set by Terraform. Leave unset for local tests.
# RAW_BUCKET_NAME=cht-dev-companion-raw
